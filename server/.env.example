# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/sole

# JWT — use a long random string in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Seed admin account (used by `npm run seed`)
ADMIN_NAME=SOLE Admin
ADMIN_EMAIL=admin@sole.com
ADMIN_PASSWORD=Admin@12345
